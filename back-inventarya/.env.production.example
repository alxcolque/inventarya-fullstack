# INVENTARYA backend production template
# Copy to .env.production outside source control and replace every CHANGE_ME value.
# Never commit the resulting file. Do not expose this file through the web server.

APP_NAME=Inventarya
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_TIMEZONE=America/La_Paz
APP_URL=https://api.inventarya.com
FRONTEND_URL=https://inventarya.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_BO
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

# Central and tenant domains.
CENTRAL_DOMAINS=inventarya.com,www.inventarya.com,api.inventarya.com,admin.inventarya.com
TENANT_ROOT_DOMAIN=inventarya.com
TENANT_ROOT_DOMAINS=inventarya.com
TENANT_DOMAIN_CACHE_TTL=300
TENANT_FRONTEND_URL=https://{tenant}.inventarya.com
TENANT_FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=https://inventarya.com,https://www.inventarya.com,https://admin.inventarya.com
REVERB_ALLOWED_ORIGINS=inventarya.com,www.inventarya.com,admin.inventarya.com,*.inventarya.com
USER_INVITATION_EXPIRES_HOURS=48

# Logging to stderr lets Docker collect application logs.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 14. DB_HOST is the private Docker service name.
DB_CONNECTION=central
DB_HOST=inventarya-postgres
DB_PORT=5432
DB_DATABASE=inventarya_central
DB_USERNAME=inventarya
DB_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_DATABASE_PASSWORD
DB_SSLMODE=prefer

# Redis 7. REDIS_HOST is the private Docker service name.
REDIS_CLIENT=phpredis
REDIS_HOST=inventarya-redis
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=inventarya_database_

CACHE_STORE=redis
CACHE_PREFIX=inventarya_cache_
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# Host-only, HTTPS-only cookies are the conservative default for tenant isolation.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=inventarya.com,www.inventarya.com,admin.inventarya.com,*.inventarya.com,api.inventarya.com

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME_REVERB_APP_ID
REVERB_APP_KEY=CHANGE_ME_PUBLIC_REVERB_APP_KEY
REVERB_APP_SECRET=CHANGE_ME_GENERATE_A_STRONG_REVERB_SECRET
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_HOST=inventarya-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false

# Use smtp, resend or another configured production mail transport.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@inventarya.com
MAIL_FROM_NAME="${APP_NAME}"

# Local storage works with the shared Docker volume. Prefer R2/S3 before
# horizontal scaling and provide the corresponding credentials below.
FILESYSTEM_DISK=local
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=CHANGE_ME_IF_R2_IS_ENABLED
R2_SECRET_ACCESS_KEY=CHANGE_ME_IF_R2_IS_ENABLED
R2_BUCKET=inventarya
R2_ENDPOINT=CHANGE_ME_IF_R2_IS_ENABLED
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
R2_PUBLIC_URL=CHANGE_ME_IF_R2_IS_ENABLED

# Optional third-party integrations. Keep private keys only in this backend file.
FIREBASE_PROJECT_ID=CHANGE_ME_IF_PUSH_IS_ENABLED
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
IMAGEKIT_PUBLIC_KEY=CHANGE_ME_IF_IMAGEKIT_IS_ENABLED
IMAGEKIT_PRIVATE_KEY=CHANGE_ME_IF_IMAGEKIT_IS_ENABLED
IMAGEKIT_URL_ENDPOINT=CHANGE_ME_IF_IMAGEKIT_IS_ENABLED

# Backups are NOT executed automatically in Phase 1. Only the central PostgreSQL
# connection is configured until tenant backup / restore is implemented and tested.
BACKUP_DB_CONNECTIONS=central
BACKUP_DISK=backups
BACKUP_DOWNLOAD_ENABLED=false
BACKUP_NOTIFICATION_EMAIL=ops@inventarya.com
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_ARCHIVE_PASSWORD

# This seeder is never called by DatabaseSeeder. Use these only for the explicit,
# controlled command documented in DEPLOYMENT.md.
SUPERADMIN_NAME=CHANGE_ME_SUPERADMIN_NAME
SUPERADMIN_EMAIL=CHANGE_ME_SUPERADMIN_EMAIL
SUPERADMIN_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_SUPERADMIN_PASSWORD

# Optional Android WebView origin; enable explicitly when deploying the mobile bridge.
# NATIVE_APP_ORIGINS=https://localhost
