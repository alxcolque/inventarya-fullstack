# INVENTARYA frontend production template
# Every VITE_* value is public and embedded into the JavaScript bundle.
# Never place passwords, private API keys, tokens or backend secrets here.

VITE_SITE_URL=https://inventarya.com
VITE_CENTRAL_URL=https://inventarya.com
VITE_API_PUBLIC_URL=https://api.inventarya.com/
VITE_API_URL=https://api.inventarya.com/api

VITE_CENTRAL_HOSTNAMES=inventarya.com,www.inventarya.com,admin.inventarya.com
VITE_TENANT_ROOT_DOMAIN=inventarya.com

# Optional browser key: if geocoding is enabled, restrict it by HTTP referrer
# and quota in the provider console. It is not a private server credential.
VITE_API_KEY_GEOCODING=CHANGE_ME_PUBLIC_BROWSER_KEY_IF_ENABLED

# The Reverb app key is a public identifier. The REVERB_APP_SECRET belongs only
# in the backend environment and must never be added to this file.
VITE_REVERB_APP_KEY=CHANGE_ME_PUBLIC_REVERB_APP_KEY
VITE_REVERB_HOST=api.inventarya.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
