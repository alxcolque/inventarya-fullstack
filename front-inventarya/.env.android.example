# Plantilla de configuración de entorno para compilación Android (INVENTARYA)
# Copiar a .env.android para anular o ajustar variables específicas de Android.
# Android y Web consumen exactamente la misma arquitectura y variables VITE_*.
# Solo valores públicos incrustados en el bundle JavaScript. Nunca secretos.

VITE_SITE_URL=https://inventarya.com
VITE_CENTRAL_URL=https://inventarya.com
VITE_API_PUBLIC_URL=https://api.inventarya.com/
VITE_API_URL=https://api.inventarya.com/api

VITE_CENTRAL_HOSTNAMES=inventarya.com,www.inventarya.com,admin.inventarya.com
VITE_TENANT_ROOT_DOMAIN=inventarya.com

# Opcional: Reverb para eventos en tiempo real
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=api.inventarya.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
