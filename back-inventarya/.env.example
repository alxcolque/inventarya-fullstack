APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
TENANT_FRONTEND_URL=http://{tenant}.localhost:5173
TENANT_FRONTEND_PORT=5173
TENANT_ROOT_DOMAIN=inventarya.com
TENANT_ROOT_DOMAINS=inventarya.com
TENANT_DOMAIN_CACHE_TTL=300
CENTRAL_DOMAINS=inventarya.com,www.inventarya.com,api.inventarya.com,admin.inventarya.com
CORS_ALLOWED_ORIGINS=
REVERB_ALLOWED_ORIGINS=
USER_INVITATION_EXPIRES_HOURS=48

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
#APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=central_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MEDIA_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inventarya
R2_ENDPOINT=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
R2_PUBLIC_URL=

FIREBASE_PROJECT_ID=inventarya-d0e77
FIREBASE_CREDENTIALS=storage/app/private/firebase/service-account.json

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Reverb Configuration
REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret

REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Backups are manual in development. Production uses its own template.
BACKUP_DB_CONNECTIONS=central
BACKUP_DISK=backups
BACKUP_DOWNLOAD_ENABLED=true
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

# Used only when SuperadminSeeder is executed explicitly.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional Android WebView origin; enable explicitly when deploying the mobile bridge.
# NATIVE_APP_ORIGINS=https://localhost
